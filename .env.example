# ===== 本番の環境変数（実値はGitに入れず、ホスティング側のシークレット機能で設定する）=====
# 開発では scripts\setup.ps1 が .env.local に自動保存する（このファイルは見本で、読み込まれない）。
# プロセス環境変数があれば .env.local より優先される。
#
# 暗号化鍵（必須）: 一度だけ生成してシークレットに登録し、以後は固定する。再デプロイで変えない。
#   生成: py -m server.manage generate-key（値をシークレットへ貼るだけ。起動スクリプトでは実行しない）
#   DBのバックアップとは別の場所（パスワードマネージャー等）にも保管する。鍵を失うと保存済みAPIキーは復元できない。
#   鍵の変更はローテーション操作のみ: 'HEVY_KEY_ENCRYPTION_KEYS=新kid:新鍵,旧kid:旧鍵' を設定 → py -m server.manage rotate-keys → 旧鍵を外す
HEVY_KEY_ENCRYPTION_KEY=
# 公開URL（https必須。招待リンクの生成に使う）
PUBLIC_BASE_URL=https://example.invalid
# SQLiteの保存先。必ず永続ボリューム上にする（再デプロイ・再起動で消えないこと）
DATABASE_PATH=/data/app.db
# リバースプロキシ（HTTPS終端）の背後で動かす場合は 1
TRUST_PROXY=1
# 任意: SESSION_TTL_DAYS=14 / MIN_SYNC_INTERVAL_SECONDS=10 / HEVY_PAGE_DELAY=0.25
