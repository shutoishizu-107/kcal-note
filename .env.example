# ===== 本番の環境変数（実値はGitに入れず、ホスティング側のシークレット機能で設定する）=====
# 暗号化鍵（必須）: py -m server.manage generate-key で生成。紛失・変更すると保存済みHevy APIキーを復号できなくなる。
# ローテーション時は 'k2:<新鍵>,k1:<旧鍵>' のように先頭を新鍵にして並べ、`manage rotate-keys` 後に旧鍵を外す。
HEVY_KEY_ENCRYPTION_KEY=
# 公開URL（https必須。招待リンクの生成に使う）
PUBLIC_BASE_URL=https://example.invalid
# SQLiteの保存先。必ず永続ボリューム上にする（再デプロイ・再起動で消えないこと）
DATABASE_PATH=/data/app.db
# リバースプロキシ（HTTPS終端）の背後で動かす場合は 1
TRUST_PROXY=1
# 任意: SESSION_TTL_DAYS=14 / MIN_SYNC_INTERVAL_SECONDS=10 / HEVY_PAGE_DELAY=0.25
